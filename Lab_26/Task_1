#include <iostream>
#include <string>
#include <sstream>

using namespace std;

// ==========================================
// Базовий клас: IPAddress
// ==========================================
class IPAddress {
protected:
    string ip_value;

public:
    IPAddress(const string& ip) : ip_value(ip) {}
    IPAddress(const IPAddress& other) : ip_value(other.ip_value) {}

    virtual void print() const {
        cout << "IP Address: " << ip_value;
    }

    virtual ~IPAddress() {}
};

// ==========================================
// Похідний клас: IPAddressChecked
// ==========================================
class IPAddressChecked : public IPAddress {
private:
    bool is_correct;

    bool validateIP(const string& ip) const {
        stringstream ss(ip);
        int num1, num2, num3, num4;
        char ch1, ch2, ch3;

        if (ss >> num1 >> ch1 >> num2 >> ch2 >> num3 >> ch3 >> num4) {
            if (ch1 == '.' && ch2 == '.' && ch3 == '.') {
                if ((num1 >= 0 && num1 <= 255) &&
                    (num2 >= 0 && num2 <= 255) &&
                    (num3 >= 0 && num3 <= 255) &&
                    (num4 >= 0 && num4 <= 255)) {
                    
                    string extra;
                    if (!(ss >> extra)) {
                        return true; 
                    }
                }
            }
        }
        return false;
    }

public:
    IPAddressChecked(const string& ip) : IPAddress(ip) {
        is_correct = validateIP(ip); 
    }

    IPAddressChecked(const IPAddressChecked& other) 
        : IPAddress(other), is_correct(other.is_correct) {}

    void print() const override {
        IPAddress::print(); 
        cout << " | Status: " << (is_correct ? "Correct" : "Not Correct");
    }
};

// ==========================================
// Тестовий код
// ==========================================
int main() {
    string in1, in2, in3;

    cout << "Enter IP for base IPAddress: ";
    getline(cin, in1);
    cout << "Enter IP for derived IPAddressChecked 1: ";
    getline(cin, in2);
    cout << "Enter IP for derived IPAddressChecked 2: ";
    getline(cin, in3);

    IPAddress baseObj(in1);
    IPAddressChecked checkedObj1(in2);
    
    IPAddressChecked temp(in3);
    IPAddressChecked checkedObj2(temp);

    cout << "\n--- Displaying Values Polymorphically ---\n";

    IPAddress* collection[3];
    collection[0] = &baseObj;       
    collection[1] = &checkedObj1;   
    collection[2] = &checkedObj2;   

    for (int i = 0; i < 3; i++) {
        collection[i]->print(); 
        cout << endl; 
    }

    return 0;
}
