#include <iostream>

using namespace std;

// ==========================================
// Базовий клас: Tree (Спільний інтерфейс)
// ==========================================
class Tree {
public:
    // Віртуальний метод для малювання
    virtual void draw() const {
        cout << "Base Tree" << endl;
    }

    // Віртуальний деструктор для коректного очищення пам'яті
    virtual ~Tree() {}
};

class SlashTree : public Tree {
public:
    void draw() const override {
        cout << "Drawing 1:\n";
        cout << "  /\\\n";
        cout << " //\\\\\n";
    }
};

class StarTree : public Tree {
public:
    void draw() const override {
        cout << "Drawing 2:\n";
        cout << "  /\\\n";
        cout << " /**\\\n";
    }
};

class PlusTree : public Tree {
public:
    void draw() const override {
        cout << "Drawing 3:\n";
        cout << "  /\\\n";
        cout << " /++\\\n";
    }
};

int main() {

    SlashTree tree1;
    StarTree  tree2;
    PlusTree  tree3;

    // Створюємо таблицю (масив) із 3-х вказівників на базовий клас Tree
    Tree* forest[3];

    // Призначаємо вказівники на наші конкретні об'єкти коміркам масиву
    forest[0] = &tree1;
    forest[1] = &tree2;
    forest[2] = &tree3;

    cout << "--- START POLYMORPHIC DRAWING ---\n\n";

    for (int i = 0; i < 3; i++) {
        forest[i]->draw();
        cout << "\n"; 
    }

    return 0;
}
